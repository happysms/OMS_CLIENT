# Optional process environment. Copy values into your service environment.
# The server does not automatically load .env files.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765
DASHBOARD_DATA_ROOT=/data
# DASHBOARD_STATE_DIR=/absolute/private/runtime-directory
# Set a login password interactively with: python server.py --init-password
# DASHBOARD_BEHIND_PROXY=1
# DASHBOARD_TRUSTED_HOSTS=localhost,127.0.0.1,server-ip,.trycloudflare.com
DASHBOARD_THREADS=2
DASHBOARD_MEMORY_LIMIT=256MB
DASHBOARD_QUERY_TIMEOUT_SECONDS=60
# Fixed-domain tunnels: path only; never put the tunnel token in this repository.
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/absolute/private/tunnel-token
